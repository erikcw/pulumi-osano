<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Compiles the cookie-consent C# example once for each .NET version the SDK supports. The generated
    package targets net6.0, which NuGet resolves for any later framework; this project proves that the
    SDK and the example still build on each of them. The example keeps a single TargetFramework because
    `pulumi up` runs it with `dotnet run`, which refuses multi-targeted projects.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../examples/cookie-consent/csharp/Program.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../sdk/dotnet/Community.Pulumi.Osano.csproj" />
    <PackageReference Include="Pulumi" Version="[3.114.0, 4.0.0)" />
  </ItemGroup>
</Project>
